{
  "name": "operatingroom",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && npm exec cap sync",
    "ios:sync": "npm run mobile:build && npm exec cap sync ios",
    "ios:verify": "npm run ios:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -sdk iphonesimulator -configuration Debug -derivedDataPath /tmp/orm-derived-data CODE_SIGNING_ALLOWED=NO build",
    "ios:open": "npm exec cap open ios",
    "ios:build": "npm run ios:sync && npm run ios:open",
    "android:add": "npm exec cap add android",
    "android:sync": "npm run mobile:build && npm exec cap sync android",
    "android:verify": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npm exec cap open android",
    "android:build": "npm run android:sync && npm run android:open"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-email/render": "^2.0.10",
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "recharts": "^3.9.2",
    "resend": "^6.17.2",
    "sonner": "^2.0.3",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.2",
    "vite": "^8.1.4"
  }
}
